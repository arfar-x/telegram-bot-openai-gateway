# Copy to .env (`make setup` does it and fills the generated values).

# From @BotFather.
BOT_TOKEN=

# The OpenAI-compatible endpoint the bot talks to: any service that serves /chat/completions and
# /models in the OpenAI shape (OpenAI, vLLM, Ollama, LiteLLM, another gateway, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional. Used only to list models (/model) for a user who is not linked yet; linked users act
# under their own key.
OPENAI_API_KEY=
# The model a new session starts with. Users change it with /model.
DEFAULT_MODEL=

# The bot's own PostgreSQL. POSTGRES_PASSWORD appears twice -- here and in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://telegram_bot:<POSTGRES_PASSWORD>@db:5432/telegram_bot
# Encrypts the API keys stored for linked users. Losing it means linking everyone again.
CREDS_KEY=

# A 👀 on a message only when it is worth it: it waits behind a running turn, or its answer takes
# longer than REACTION_DELAY seconds. Removed when that message has been answered.
REACTIONS=true
REACTION_DELAY=10
# Show the endpoint's reasoning as one silent, self-editing message.
SHOW_PROGRESS=false
# Seconds without data from the endpoint before a request is given up.
REQUEST_TIMEOUT=600

# Webhook instead of long polling: set both (the secret is required with the URL).
WEBHOOK_URL=
WEBHOOK_SECRET=
