# Copy to .env (`make setup` does it and fills the generated values).

# From @BotFather.
BOT_TOKEN=

# The OpenAI-compatible endpoint the bot talks to: any service that serves /chat/completions and
# /models in the OpenAI shape (OpenAI, vLLM, Ollama, LiteLLM, another gateway, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional. Used only to list models (/model) for a user who is not linked yet; linked users act
# under their own key.
OPENAI_API_KEY=
# The model a new session starts with. Users change it with /model.
DEFAULT_MODEL=

# The bot's own PostgreSQL. POSTGRES_PASSWORD appears twice -- here and in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://telegram_bot:<POSTGRES_PASSWORD>@db:5432/telegram_bot
# Encrypts the API keys stored for linked users. Losing it means linking everyone again.
CREDS_KEY=

# A 👀 on a message only when it is worth it: it waits behind a running turn, or its answer takes
# longer than REACTION_DELAY seconds. Removed when that message has been answered.
REACTIONS=true
REACTION_DELAY=10
# Show the endpoint's reasoning as one silent, self-editing message.
SHOW_PROGRESS=false
# Seconds a request to the endpoint may take in all before it is given up.
REQUEST_TIMEOUT=600
# Characters of history sent to the endpoint with each request; the oldest whole turns are dropped past it.
HISTORY_MAX_CHARS=200000
# Days the text of messages is kept for quoting replies.
MESSAGE_TEXT_DAYS=30
# Turns one person may have running at the same time across chats; further ones wait.
MAX_CONCURRENT_TURNS=2

# The tools the bot lets the endpoint call, all carried out in Telegram: request_approval, send_file,
# send_image, send_buttons, notify, react, get_context. Empty = all, "none" = only the always-on
# clarify, or a comma list such as send_file,notify. TOOL_MAX_FILE_BYTES caps a file sent with send_file.
TOOLS=
TOOL_MAX_FILE_BYTES=1048576

# Reaching Telegram from a slow or filtered network: a proxy URL (http://host:port or socks5://host:port)
# and the connection and read timeouts, in seconds.
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=20
TELEGRAM_READ_TIMEOUT=30

# Webhook instead of long polling: set both (the secret is required with the URL).
WEBHOOK_URL=
WEBHOOK_SECRET=
